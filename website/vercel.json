{
  "headers": [
    { "source": "/(favicon.ico|favicon.svg|favicon.png|logo.svg|logo-white.svg|logo-mark.svg|apple-touch-icon.png|og-image.png|icon-192.png|icon-512.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/api/v1/:path*", "destination": "/api/:path*" },
    { "source": "/api/api/:path*", "destination": "/api/:path*" },
    { "source": "/api/v1/:path*", "destination": "/api/:path*" }
  ]
}
